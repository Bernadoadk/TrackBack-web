---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, type Lang } from '../config/site';
import { ROUTES, type RouteKey } from '../i18n/routes';
import { UI } from '../i18n/ui';
import { breadcrumbNode, organizationNode, serializeGraph, webPageNode, websiteNode } from '../lib/schema';

interface Props {
  lang: Lang;
  /** null for pages that exist in a single version (404). */
  route: RouteKey | null;
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes (app, FAQ…) added to the page graph. */
  schema?: Record<string, unknown>[];
  pageType?: string;
  /** When set, adds a BreadcrumbList (Home › name). */
  breadcrumbName?: string;
  aboutApp?: boolean;
}

const {
  lang,
  route,
  title,
  description,
  ogImage,
  noindex = false,
  schema = [],
  pageType,
  breadcrumbName,
  aboutApp = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://trackback-web.vercel.app');
const t = UI[lang];
const canonical = route ? new URL(ROUTES[route][lang], site).href : null;
const alternates = route
  ? { en: new URL(ROUTES[route].en, site).href, fr: new URL(ROUTES[route].fr, site).href }
  : null;
const image = new URL(ogImage ?? (lang === 'fr' ? '/og-image-fr.png' : '/og-image.png'), site).href;
const imageAlt =
  lang === 'fr'
    ? 'TrackBack Returns — portail de retour Shopify avec avoirs, échanges et remboursements'
    : 'TrackBack Returns — Shopify return portal with store credit, exchanges and refunds';

const graph =
  route && !noindex && canonical
    ? [
        organizationNode(site),
        websiteNode(site),
        webPageNode({
          site,
          lang,
          url: canonical,
          title,
          description,
          image,
          type: pageType,
          withBreadcrumb: Boolean(breadcrumbName),
          aboutApp,
          dateModified: ROUTES[route].updated,
        }),
        ...(breadcrumbName ? [breadcrumbNode({ site, lang, route, name: breadcrumbName, homeName: t.breadcrumbHome })] : []),
        ...schema,
      ]
    : [];
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    {
      alternates && !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="fr" href={alternates.fr} />
          <link rel="alternate" hreflang="x-default" href={alternates.en} />
        </>
      )
    }
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {graph.length > 0 && <script type="application/ld+json" set:html={serializeGraph(graph)} />}
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-white"
      >{t.skip}</a
    >
    <Nav lang={lang} route={route} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} route={route} />
    <Analytics />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
