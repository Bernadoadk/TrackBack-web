---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ROUTES } from '../i18n/routes';
---

<Base
  lang="en"
  route={null}
  title="Page not found | TrackBack Returns"
  description="This page doesn't exist. Go back to TrackBack Returns, the Shopify returns app."
  noindex
>
  <section class="relative overflow-hidden pb-24 pt-32 md:pt-40">
    <div class="hero-backdrop"></div>
    <div class="container-x relative max-w-2xl text-center">
      <p class="font-mono text-[15px] font-semibold text-teal-300">404</p>
      <h1 class="mt-3 text-[40px] font-bold leading-tight tracking-[-0.03em] md:text-[52px]">This page took a return trip.</h1>
      <p class="mt-4 text-[17px] text-muted">The page you are looking for doesn't exist or has moved.</p>
      <p class="mt-1 text-[17px] text-muted" lang="fr">La page que vous cherchez n'existe pas ou a été déplacée.</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={ROUTES.home.en} class="btn btn-primary">
          <Icon name="arrow-left" class="h-4 w-4" />
          Back to home
        </a>
        <a href={ROUTES.home.fr} class="btn btn-secondary" lang="fr">Retour à l'accueil</a>
        <a href={ROUTES.demo.en} class="btn btn-secondary">
          <Icon name="play" class="h-4 w-4" />
          Try the demo
        </a>
      </div>
    </div>
  </section>
</Base>
