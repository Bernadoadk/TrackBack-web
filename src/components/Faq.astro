---
import Icon from './Icon.astro';
import { mailto } from '../config/site';

interface Props {
  id?: string;
  kicker: string;
  title: string;
  sub?: string;
  contactLabel?: string;
  items: { q: string; a: string }[];
}

const { id, kicker, title, sub, contactLabel, items } = Astro.props;
---

<section id={id} class="border-t border-divider py-20 md:py-28" aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <div class="reveal lg:sticky lg:top-28">
        <p class="kicker">{kicker}</p>
        <h2 id={id ? `${id}-title` : undefined} class="mt-3 text-balance text-[32px] font-bold leading-[1.1] tracking-[-0.025em] md:text-[40px]">
          {title}
        </h2>
        {
          sub && contactLabel && (
            <p class="mt-4 text-[17px] text-muted">
              {sub}{' '}
              <a href={mailto()} class="font-semibold text-brand-300 underline underline-offset-4 hover:text-teal-300">
                {contactLabel}
              </a>
            </p>
          )
        }
      </div>
    </div>
    <div class="space-y-3 lg:col-span-8">
      {
        items.map((item) => (
          <details class="group reveal rounded-xl border border-border bg-surface transition-colors open:border-brand-300/40 hover:border-brand-300/40">
            <summary class="flex items-start justify-between gap-4 p-5 md:p-6">
              <h3 class="text-[17px] font-semibold leading-snug text-ink">{item.q}</h3>
              <Icon name="chevron-down" class="mt-0.5 h-5 w-5 shrink-0 text-faint transition-transform duration-300 group-open:rotate-180" />
            </summary>
            <p class="-mt-1 px-5 pb-6 text-[16px] leading-relaxed text-muted md:px-6">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
