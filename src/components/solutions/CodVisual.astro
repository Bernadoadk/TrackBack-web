---
import Icon from '../Icon.astro';
import type { Lang } from '../../config/site';
import { PORTAL } from '../demo/demo-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = PORTAL[lang];
const t =
  lang === 'fr'
    ? {
        amount: '45 000 F CFA',
        credit: 'Recevez 49 500 F CFA au lieu de 45 000 F CFA',
        badge: '+10 % offerts',
        admin: 'Enregistrer le versement',
        ref: 'Référence du paiement',
        to: 'Wave · ••••4567 · Awa Diop',
        label: "Aperçu : le client choisit un remboursement Wave dans le portail, et le marchand enregistre le versement avec sa référence.",
      }
    : {
        amount: 'F CFA 45,000',
        credit: 'Get F CFA 49,500 instead of F CFA 45,000',
        badge: '+10% bonus',
        admin: 'Record payout',
        ref: 'Payment reference',
        to: 'Wave · ••••4567 · Awa Diop',
        label: 'Preview: the customer picks a Wave refund in the portal, and the merchant records the payout with its reference.',
      };
---

<div class="relative mx-auto w-full max-w-[520px]" role="img" aria-label={t.label}>
  <div aria-hidden="true" class="flex flex-col gap-4 sm:block">
    <div class="rounded-2xl bg-paper text-paper-ink shadow-[0_40px_90px_-30px_rgb(0_0_0/0.95)] sm:mr-10">
      <div class="flex items-center justify-between border-b border-paper-line px-5 py-4">
        <div>
          <p class="text-[12px] text-paper-muted">Maison Awa</p>
          <p class="text-[17px] font-bold tracking-tight">{p.returnCenter}</p>
        </div>
        <span class="rounded-full bg-brand/10 px-2.5 py-1 text-[11px] font-bold text-brand-hover">4 / 5</span>
      </div>
      <div class="p-5">
        <p class="text-[15px] font-semibold">{p.labelRefundType}</p>
        <div class="mt-3 rounded-xl border-2 border-brand bg-brand/[0.04] p-3.5">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 grid h-4 w-4 shrink-0 place-content-center rounded-full border-2 border-brand"><span class="h-1.5 w-1.5 rounded-full bg-brand"></span></span>
            <div class="min-w-0 flex-1">
              <p class="text-[14px] font-semibold">{p.refundOfflineTitle}</p>
              <p class="text-[12px] text-paper-muted">{p.refundOfflineDesc}</p>
            </div>
          </div>
          <div class="mt-3 grid gap-2 border-t border-paper-line pt-3 text-[13px]">
            <div class="flex items-center justify-between rounded-lg border border-paper-line bg-white px-3 py-2">
              <span class="text-paper-muted">{p.payoutMethod}</span><span class="font-semibold">Wave</span>
            </div>
            <div class="flex items-center justify-between rounded-lg border border-paper-line bg-white px-3 py-2">
              <span class="text-paper-muted">{p.payoutAccountPhone}</span><span class="font-mono font-semibold">+221 77 123 45 67</span>
            </div>
          </div>
        </div>
        <div class="mt-2.5 rounded-xl border border-paper-line p-3.5">
          <p class="flex flex-wrap items-center gap-1.5 text-[14px] font-semibold">
            {p.storeCreditTitle}
            <span class="rounded-full bg-emerald-500/12 px-1.5 py-0.5 text-[11px] font-bold text-emerald-700">{t.badge}</span>
          </p>
          <p class="text-[12px] text-paper-muted">{t.credit}</p>
        </div>
      </div>
    </div>
    <div class="rounded-xl border border-border bg-elevated/95 p-4 shadow-2xl sm:absolute sm:-bottom-10 sm:right-0 sm:w-[290px]">
      <p class="flex items-center justify-between gap-2 text-[13px] font-semibold text-ink">
        <span class="flex items-center gap-2"><Icon name="wallet" class="h-4 w-4 text-teal-300" />{t.admin}</span>
        <span>{t.amount}</span>
      </p>
      <p class="mt-1 text-[12px] text-muted">{t.to}</p>
      <p class="mt-3 text-[12px] text-faint">{t.ref}</p>
      <p class="mt-1 rounded-lg border border-border bg-bg px-3 py-2 font-mono text-[13px] text-ink">WAVE-8F2K1</p>
      <span class="mt-3 grid h-9 place-content-center rounded-lg bg-brand text-[13px] font-semibold text-white">{t.admin}</span>
    </div>
  </div>
</div>
