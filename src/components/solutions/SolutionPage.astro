---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../Breadcrumb.astro';
import Faq from '../Faq.astro';
import FinalCta from '../FinalCta.astro';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import WithdrawalVisual from './WithdrawalVisual.astro';
import CodVisual from './CodVisual.astro';
import { installUrl, type Lang } from '../../config/site';
import { ROUTES } from '../../i18n/routes';
import { SOLUTIONS } from '../../i18n/solutions';
import { appNode, faqNode } from '../../lib/schema';

interface Props {
  lang: Lang;
  page: 'withdrawal' | 'cod';
}

const { lang, page } = Astro.props;
const copy = SOLUTIONS[page][lang];
const site = Astro.site ?? new URL('https://trackback-web.vercel.app');
const url = new URL(ROUTES[page][lang], site).href;
const demoHref = `${ROUTES.demo[lang]}?scenario=${copy.demoScenario}#demo`;
---

<Base
  lang={lang}
  route={page}
  title={copy.meta.title}
  description={copy.meta.description}
  breadcrumbName={copy.breadcrumb}
  aboutApp
  schema={[appNode(site, lang), faqNode(url, copy.faq.items)]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden pb-24 pt-24 md:pb-32 md:pt-28">
    <div class="hero-backdrop"></div>
    <div class="container-x relative">
      <Breadcrumb lang={lang} current={copy.breadcrumb} />
      <div class="mt-6 grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-6">
          <p class="kicker">{copy.kicker}</p>
          <h1 class="mt-3 text-balance text-[36px] font-bold leading-[1.06] tracking-[-0.03em] sm:text-[46px] lg:text-[52px]">{copy.h1}</h1>
          <p class="mt-5 max-w-xl text-pretty text-[17px] leading-relaxed text-muted md:text-[19px]">{copy.lead}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={installUrl(lang, `${page}-hero`)} class="btn btn-primary" data-track="install" data-placement={`${page}-hero`}>
              {copy.primary}
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
            <a href={demoHref} class="btn btn-secondary" data-track="Demo click" data-placement={`${page}-hero`}>
              <Icon name="play" class="h-4 w-4" />
              {copy.secondary}
            </a>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-6">
          {page === 'withdrawal' ? <WithdrawalVisual lang={lang} /> : <CodVisual lang={lang} />}
        </div>
      </div>
    </div>
  </section>

  {
    copy.rules && (
      <section class="border-t border-divider py-20 md:py-28">
        <div class="container-x">
          <SectionHeading kicker={copy.rules.kicker} title={copy.rules.title} sub={copy.rules.intro} />
          <ol class="mx-auto mt-12 grid max-w-5xl gap-4 md:grid-cols-2">
            {copy.rules.items.map((item, i) => (
              <li class="reveal card p-6">
                <span class="text-[13px] font-bold text-teal-300">0{i + 1}</span>
                <h3 class="mt-2 text-[19px] font-semibold text-ink">{item.title}</h3>
                <p class="mt-2 text-[16px] leading-relaxed text-muted">{item.text}</p>
              </li>
            ))}
          </ol>
          <p class="mx-auto mt-8 flex max-w-5xl items-start gap-2.5 rounded-xl border border-border bg-surface/50 p-4 text-[14px] text-muted">
            <Icon name="info" class="mt-0.5 h-4 w-4 shrink-0 text-brand-300" />
            {copy.rules.disclaimer}
          </p>
        </div>
      </section>
    )
  }

  {
    copy.problem && (
      <section class="border-t border-divider py-20 md:py-24">
        <div class="container-x">
          <div class="reveal mx-auto max-w-3xl rounded-2xl border border-border bg-surface/60 p-7 md:p-10">
            <p class="kicker">{copy.problem.kicker}</p>
            <h2 class="mt-3 text-balance text-[28px] font-bold leading-tight tracking-tight md:text-[34px]">{copy.problem.title}</h2>
            <p class="mt-4 text-[17px] leading-relaxed text-muted">{copy.problem.text}</p>
          </div>
        </div>
      </section>
    )
  }

  <!-- How it works -->
  <section class="border-t border-divider bg-surface/30 py-20 md:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="reveal lg:sticky lg:top-28">
          <p class="kicker">{copy.how.kicker}</p>
          <h2 class="mt-3 text-balance text-[32px] font-bold leading-[1.1] tracking-[-0.025em] md:text-[40px]">{copy.how.title}</h2>
          {
            copy.methods && (
              <div class="mt-8">
                <h3 class="text-[15px] font-semibold text-ink">{copy.methods.title}</h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {copy.methods.list.map((m) => (
                    <li class="rounded-lg border border-border bg-surface px-3 py-1.5 text-[14px] text-ink">{m}</li>
                  ))}
                </ul>
                <p class="mt-3 text-[14px] text-faint">{copy.methods.note}</p>
              </div>
            )
          }
        </div>
      </div>
      <ol class="relative space-y-4 lg:col-span-7">
        {
          copy.how.steps.map((step, i) => (
            <li class="reveal card flex gap-4 p-5 md:p-6">
              <span class="grid h-9 w-9 shrink-0 place-content-center rounded-full border border-brand-300/40 text-[15px] font-bold text-brand-300">{i + 1}</span>
              <div>
                <h3 class="text-[18px] font-semibold text-ink">{step.title}</h3>
                <p class="mt-1.5 text-[16px] leading-relaxed text-muted">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    copy.extras && (
      <section class="border-t border-divider py-20 md:py-28">
        <div class="container-x">
          <SectionHeading kicker={copy.extras.kicker} title={copy.extras.title} />
          <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {copy.extras.items.map((item) => (
              <article class="reveal card p-6">
                <span class="grid h-11 w-11 place-content-center rounded-xl border border-border bg-elevated text-teal-300">
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-5 text-[18px] font-semibold text-ink">{item.title}</h3>
                <p class="mt-2 text-[16px] leading-relaxed text-muted">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Faq id={`${page}-faq`} kicker={copy.faq.kicker} title={copy.faq.title} items={copy.faq.items} />

  <FinalCta
    lang={lang}
    title={copy.final.title}
    sub={copy.final.sub}
    primary={copy.primary}
    secondary={{ label: copy.secondary, href: demoHref }}
    placement={`${page}-final`}
  />
</Base>
