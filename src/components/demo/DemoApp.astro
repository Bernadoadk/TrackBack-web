---
import Icon from '../Icon.astro';
import type { Lang } from '../../config/site';
import { DEMO, SCENARIO_ORDER } from './demo-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = DEMO[lang];
---

<div data-demo data-lang={lang} data-tab="customer" class="group/demo">
  <div class="flex items-center justify-between gap-3">
    <p id="demo-scenarios-label" class="text-[14px] font-semibold text-muted">{T.scenarioLabel}</p>
    <button type="button" data-action="restart" class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1 text-[14px] font-semibold text-muted transition-colors hover:text-ink">
      <Icon name="refresh" class="h-4 w-4" />
      {T.restart}
    </button>
  </div>

  <div
    data-scenarios
    role="group"
    aria-labelledby="demo-scenarios-label"
    class="-mx-4 mt-3 flex gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0"
  >
    {
      SCENARIO_ORDER.map((key, i) => (
        <button
          type="button"
          data-action="scenario"
          data-value={key}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="shrink-0 rounded-xl border border-border bg-surface px-3.5 py-2.5 text-left"
        >
          <span class="block text-[14px] font-semibold text-muted">{T.scenarios[key].label}</span>
          <span class="block text-[12px] text-faint">{T.scenarios[key].hint}</span>
        </button>
      ))
    }
  </div>

  <div role="tablist" aria-label={T.scenarioLabel} class="mt-4 grid grid-cols-2 gap-1 rounded-xl border border-border bg-surface p-1 lg:hidden">
    <button
      type="button"
      role="tab"
      data-action="tab"
      data-value="customer"
      aria-selected="true"
      aria-controls="demo-customer"
      class="rounded-lg px-3 py-2.5 text-[14px] font-semibold text-muted transition-colors aria-selected:bg-elevated aria-selected:text-ink"
    >
      {T.tabs.customer}
    </button>
    <button
      type="button"
      role="tab"
      data-action="tab"
      data-value="merchant"
      aria-selected="false"
      aria-controls="demo-merchant"
      tabindex="-1"
      class="flex items-center justify-center gap-2 rounded-lg px-3 py-2.5 text-[14px] font-semibold text-muted transition-colors aria-selected:bg-elevated aria-selected:text-ink"
    >
      {T.tabs.merchant}
      <span data-unseen hidden class="grid h-5 min-w-5 place-content-center rounded-full bg-teal px-1 text-[11px] font-bold text-white"></span>
    </button>
  </div>

  <div class="mt-4 grid items-start gap-5 lg:mt-6 lg:grid-cols-12">
    <section
      id="demo-customer"
      data-panel="customer"
      role="tabpanel"
      aria-label={T.customerSide}
      class="scroll-mt-24 lg:col-span-7 max-lg:group-data-[tab=merchant]/demo:hidden"
    >
      <p class="mb-2.5 hidden items-center gap-2 text-[13px] font-semibold uppercase tracking-wider text-faint lg:flex">
        <Icon name="bag" class="h-4 w-4" />
        {T.customerSide}
      </p>
      <div data-portal class="min-h-[520px] overflow-hidden rounded-2xl bg-paper text-paper-ink shadow-[0_40px_90px_-40px_rgb(0_0_0/0.95)] [color-scheme:light]">
        <div class="grid min-h-[520px] place-content-center p-8 text-center text-[15px] text-paper-muted">
          <noscript>{lang === 'fr' ? 'Activez JavaScript pour essayer la démo.' : 'Enable JavaScript to try the demo.'}</noscript>
        </div>
      </div>
    </section>

    <section
      id="demo-merchant"
      data-panel="merchant"
      role="tabpanel"
      aria-label={T.merchantSide}
      class="scroll-mt-24 lg:col-span-5 max-lg:group-data-[tab=customer]/demo:hidden"
    >
      <p class="mb-2.5 hidden items-center gap-2 text-[13px] font-semibold uppercase tracking-wider text-faint lg:flex">
        <Icon name="layout" class="h-4 w-4" />
        {T.merchantSide}
      </p>
      <div data-merchant class="min-h-[520px] rounded-2xl border border-border bg-surface transition-shadow"></div>
    </section>
  </div>

  <p class="mt-4 flex items-center gap-2 text-[13px] text-faint">
    <Icon name="info" class="h-4 w-4 shrink-0" />
    {T.notice}
  </p>
</div>

<div data-demo-toasts role="status" aria-live="polite" hidden class="pointer-events-none fixed inset-x-0 bottom-5 z-40 flex justify-center px-4"></div>

<script>
  import './demo-client';
</script>
