---
import Icon from '../Icon.astro';
import PlanBadges from '../PlanBadges.astro';
import SectionHeading from '../SectionHeading.astro';
import type { Lang } from '../../config/site';
import { ROUTES } from '../../i18n/routes';
import type { HomeCopy } from '../../i18n/home';

interface Props {
  lang: Lang;
  diff: HomeCopy['diff'];
}

const { lang, diff } = Astro.props;
const accents = ['from-brand/25 to-brand/5 text-brand-300', 'from-teal/25 to-teal/5 text-teal-300'];
---

<section class="py-20 md:py-28">
  <div class="container-x">
    <SectionHeading kicker={diff.kicker} title={diff.title} sub={diff.sub} />
    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {
        diff.items.map((item, i) => (
          <article class="reveal card flex flex-col p-6 md:p-8">
            <div class="flex items-start justify-between gap-4">
              <span class={`grid h-12 w-12 place-content-center rounded-xl bg-linear-to-br ${accents[i % 2]}`}>
                <Icon name={item.icon} class="h-6 w-6" />
              </span>
              <PlanBadges plans={item.plans} lang={lang} from />
            </div>
            <h3 class="mt-5 text-[21px] font-semibold leading-snug tracking-tight text-ink">{item.title}</h3>
            <p class="mt-3 flex-1 text-[16px] leading-relaxed text-muted">{item.text}</p>
            {item.link && (
              <a
                href={ROUTES[item.link.route][lang]}
                class="group mt-5 inline-flex items-center gap-1.5 self-start text-[15px] font-semibold text-brand-300 hover:text-teal-300"
              >
                {item.link.label}
                <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
