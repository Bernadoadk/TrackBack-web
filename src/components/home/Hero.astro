---
import Icon from '../Icon.astro';
import HeroVisual from './HeroVisual.astro';
import { installUrl, type Lang } from '../../config/site';
import { ROUTES } from '../../i18n/routes';
import type { HomeCopy } from '../../i18n/home';

interface Props {
  lang: Lang;
  copy: HomeCopy;
}

const { lang, copy } = Astro.props;
const { hero, banner, visual } = copy;
const visualLabel =
  lang === 'fr'
    ? "Aperçu : le portail de retour TrackBack propose un avoir avec 10 % de bonus, et la liste des retours côté marchand."
    : "Preview: the TrackBack return portal offering store credit with a 10% bonus, next to the merchant's list of returns.";
---

<section class="relative overflow-hidden pb-20 pt-28 md:pb-28 md:pt-36">
  <div class="hero-backdrop"></div>
  <div class="container-x relative">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="min-w-0 text-center lg:col-span-6 lg:text-left">
        <a
          href={ROUTES.withdrawal[lang]}
          class="group inline-flex max-w-full items-center gap-2 rounded-2xl border border-border bg-surface/80 py-1 pl-1 pr-3 text-left text-[13px] text-muted transition-colors hover:border-brand-300/60 hover:text-ink sm:rounded-full"
        >
          <span class="rounded-full bg-teal/20 px-2 py-0.5 text-[12px] font-semibold text-teal-300">{banner.label}</span>
          <span class="min-w-0 sm:truncate">{banner.text}</span>
          <Icon name="arrow-right" class="h-3.5 w-3.5 shrink-0 transition-transform group-hover:translate-x-0.5" />
        </a>

        <h1 class="mt-6 text-balance text-[44px] font-bold leading-[1.02] tracking-[-0.035em] sm:text-[56px] lg:text-[62px] xl:text-[70px]">
          {hero.h1a}
          <span class="block text-gradient">{hero.h1b}</span>
        </h1>

        <p class="mx-auto mt-6 max-w-xl text-pretty text-[17px] leading-relaxed text-muted md:text-[19px] lg:mx-0">
          {hero.sub}
        </p>

        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start">
          <a href={installUrl(lang, 'hero')} class="btn btn-primary" data-track="install" data-placement="hero">
            {hero.primary}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href={ROUTES.demo[lang]} class="btn btn-secondary" data-track="Demo click" data-placement="hero">
            <Icon name="play" class="h-4 w-4" />
            {hero.secondary}
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap justify-center gap-x-5 gap-y-2 text-[14px] text-muted lg:justify-start">
          {
            hero.trust.map((item) => (
              <li class="flex items-center gap-1.5">
                <Icon name="check" class="h-4 w-4 text-teal-300" strokeWidth={2.5} />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="min-w-0 lg:col-span-6">
        <HeroVisual v={visual} label={visualLabel} />
      </div>
    </div>
  </div>
</section>
