---
import type { HomeCopy } from '../../i18n/home';

interface Props {
  facts: HomeCopy['facts'];
}

const { facts } = Astro.props;
---

<section class="border-y border-divider bg-surface/40">
  <dl class="container-x grid grid-cols-2 gap-x-6 gap-y-8 py-10 md:grid-cols-4 md:py-12">
    {
      facts.map((fact) => (
        <div class="flex flex-col-reverse text-center md:text-left">
          <dt class="mt-2 text-[14px] leading-snug text-muted">{fact.label}</dt>
          <dd class="text-[34px] font-bold leading-none tracking-tight text-ink md:text-[40px]">{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
